# Which realtime AI provider: "gemini" (free) or "openai" (paid)
AI_PROVIDER=gemini

# Which telephony provider: "exotel" (default) or "plivo" (fallback after KYC)
TELEPHONY_PROVIDER=exotel

# --- Gemini Live (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_THINKING_BUDGET=0
# ~400ms balances speed vs stable multi-turn replies
GEMINI_SILENCE_MS=400
GEMINI_PREFIX_PADDING_MS=20
# Phase 1: soft Gemini session reset on long calls (0 = disable)
GEMINI_SOFT_RESET_EVERY_TURNS=22
GEMINI_SOFT_RESET_EVERY_SEC=480
GEMINI_DIGEST_MAX_CHARS=1800
GEMINI_DIGEST_MAX_CHARS=1200

# --- OpenAI Realtime (only if AI_PROVIDER=openai) ---
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime

# Female clear Gemini voices: Erinome (Clear), Kore (Firm), Aoede (Breezy friendly), Achernar (Soft)
VOICE=Aoede

# Optional persona — see docs/VOICE_AND_PERSONA.md
AGENT_NAME=
VOICE_PERSONA=Warm, patient front-desk tone. Simple words. Confirm what the caller needs before answering.

# Sheet: keep conversation column short on voice_calls tab
SHEET_CONVERSATION_PREVIEW_TURNS=5
SHEET_CONVERSATION_PREVIEW_MAX_CHARS=300

PUBLIC_HOST=examining-lodging-couple-appropriations.trycloudflare.com
PORT=5000
EXOTEL_SAMPLE_RATE=8000

N8N_WEBHOOK_URL=https://your-n8n-host/webhook/voice-agent
NOTIFY_WHATSAPP=

SILENCE_TIMEOUT_SEC=45
MAX_CALL_DURATION_SEC=600
END_CALL_GRACE_SEC=2.5
AI_RESPONSE_NUDGE_SEC=3.5

BUSINESS_NAME=Bright Smile Dental Clinic
# Official site — short text summary is fetched at startup
BUSINESS_WEBSITE=https://www.example.com
# Curated facts (best accuracy). Also edit business_knowledge.md
BUSINESS_CONTEXT=We are a dental clinic. Hours Mon-Sat 10am-7pm. Cleaning and checkups available.
BUSINESS_CONTEXT_FILE=business_knowledge.md
BUSINESS_CONTEXT_MAX_CHARS=3500

# Phase 1: lookup_knowledge searches business_knowledge.md before n8n
KNOWLEDGE_SEARCH_LOCAL_FIRST=true
KNOWLEDGE_SEARCH_MAX_CHARS=2000

GREETING=Thank you for calling Bright Smile Dental. I can help in English or Hindi — how may I help you?
SYSTEM_PROMPT=You are a warm, accurate phone receptionist for Bright Smile Dental Clinic. Answer only from company knowledge and tool results. Keep every spoken reply under 2 short sentences. Ask one question at a time. Never monologue. Use tools when needed.
