# =============================================================================
# Voice Agent — environment configuration
# Copy:  cp .env.example .env
# Docs:  README.md, docs/PHASE1_SETUP_GUIDE.md, docs/VOICE_AND_PERSONA.md
# =============================================================================


# -----------------------------------------------------------------------------
# Provider selection
# -----------------------------------------------------------------------------
# Realtime AI: gemini (free tier) | openai (paid)
AI_PROVIDER=gemini

# Telephony: exotel (default, India) | plivo (after KYC/compliance)
TELEPHONY_PROVIDER=exotel


# -----------------------------------------------------------------------------
# Server & public URL (tunnel)
# -----------------------------------------------------------------------------
# HTTPS host only — no https:// — from cloudflared / ngrok
PUBLIC_HOST=examining-lodging-couple-appropriations.trycloudflare.com

# Local bind port (uvicorn)
PORT=5000


# -----------------------------------------------------------------------------
# Telephony — Exotel / Plivo
# -----------------------------------------------------------------------------
# PCM sample rate on Exotel Voicebot stream: 8000 | 16000 | 24000
# Must match Exotel applet + wss URL ?sample-rate=
EXOTEL_SAMPLE_RATE=8000

# Inbound speech detection on PCM16 (ignore line noise). Default 400.
# SPEECH_RMS_THRESHOLD=400

# Outbound frame size @ 8kHz (~100ms = 1600). Do not use 3200 unless Exotel requires it.
EXOTEL_FRAME_BYTES=1600

# SPEECH_END_GAP_SEC=0.9
# CALLER_LISTEN_GRACE_SEC=1.4


# -----------------------------------------------------------------------------
# Gemini Live (AI_PROVIDER=gemini)
# Key: https://aistudio.google.com/apikey
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-live-preview

# Latency vs listening: higher silence_ms = waits longer before replying
GEMINI_THINKING_BUDGET=0
GEMINI_THINKING_LEVEL=minimal
GEMINI_CONTEXT_COMPRESSION=true
GEMINI_SILENCE_MS=580
GEMINI_PREFIX_PADDING_MS=24
GEMINI_END_SPEECH_SENSITIVITY=low

# Long-call stability: new Live session + conversation digest (0 = disable turns)
GEMINI_SOFT_RESET_EVERY_TURNS=22
GEMINI_SOFT_RESET_EVERY_SEC=480
GEMINI_DIGEST_MAX_CHARS=1800


# -----------------------------------------------------------------------------
# OpenAI Realtime (AI_PROVIDER=openai only)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime


# -----------------------------------------------------------------------------
# Voice & persona (Gemini native-audio voices)
# -----------------------------------------------------------------------------
# Erinome (Clear), Kore (Firm), Aoede (Breezy), Achernar (Soft)
VOICE=Aoede

# Optional display name in prompts — see docs/VOICE_AND_PERSONA.md
AGENT_NAME=
VOICE_PERSONA=Warm, patient front-desk tone. Simple words. Confirm what the caller needs before answering.


# -----------------------------------------------------------------------------
# Call lifecycle (hang-up & responsiveness)
# -----------------------------------------------------------------------------
# End call if caller is silent (seconds)
SILENCE_TIMEOUT_SEC=45

# Hard cap on call length (seconds)
MAX_CALL_DURATION_SEC=600

# Wait after AI farewell before disconnect (seconds)
END_CALL_GRACE_SEC=2.5

# Nudge AI if caller spoke but model stays quiet (seconds)
AI_RESPONSE_NUDGE_SEC=4.5


# -----------------------------------------------------------------------------
# Business identity & knowledge (RAG)
# -----------------------------------------------------------------------------
BUSINESS_NAME=Bright Smile Dental Clinic

# Fetched at startup (short text scrape). Best accuracy: data/business_knowledge.md
BUSINESS_WEBSITE=https://www.example.com

# One-line extra facts (optional if file is filled)
BUSINESS_CONTEXT=We are a dental clinic. Hours Mon-Sat 10am-7pm. Cleaning and checkups available.

BUSINESS_CONTEXT_FILE=data/business_knowledge.md
BUSINESS_CONTEXT_MAX_CHARS=3500

# lookup_knowledge tool: search local file first, then n8n
KNOWLEDGE_SEARCH_LOCAL_FIRST=true
KNOWLEDGE_SEARCH_MAX_CHARS=2000


# -----------------------------------------------------------------------------
# Spoken greeting & base system prompt
# -----------------------------------------------------------------------------
# Language rules + company block appended at runtime (knowledge.py)
GREETING=Thank you for calling Bright Smile Dental. I can help in English or Hindi — how may I help you?

SYSTEM_PROMPT=You are a warm, accurate phone receptionist for Bright Smile Dental Clinic. Answer only from company knowledge and tool results. Keep every spoken reply under 2 short sentences. Ask one question at a time. Never monologue. Use tools when needed.


# -----------------------------------------------------------------------------
# n8n & post-call notifications
# -----------------------------------------------------------------------------
# Production webhook from imported workflow (voice_agent_actions.json)
N8N_WEBHOOK_URL=https://your-n8n-host/webhook/voice-agent

# Owner WhatsApp for summaries — digits + country code, e.g. 9198XXXXXXXX
NOTIFY_WHATSAPP=
