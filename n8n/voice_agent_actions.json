    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst body = raw.body || raw;\nconst action = body.action || 'unknown';\nconst args = body.args || {};\nconst callId = body.call_id || `CALL-${Date.now()}`;\nconst from = String(body.from || '').replace(/\\D/g, '');\nconst now = new Date();\nconst date = now.toISOString().slice(0, 10);\nconst timeIst = now.toLocaleTimeString('en-IN', {\n  hour: '2-digit',\n  minute: '2-digit',\n  hour12: true,\n  timeZone: 'Asia/Kolkata',\n});\n\nfunction detailsFor() {\n  const bits = [];\n  if (args.name) bits.push(`Name: ${args.name}`);\n  if (args.phone) bits.push(`Phone: ${args.phone}`);\n  if (args.service) bits.push(`Service: ${args.service}`);\n  if (args.date) bits.push(`Date: ${args.date}`);\n  if (args.time) bits.push(`Time: ${args.time}`);\n  if (args.interest) bits.push(`Interest: ${args.interest}`);\n  if (args.notes) bits.push(`Notes: ${args.notes}`);\n  if (args.message) bits.push(String(args.message));\n  if (args.query) bits.push(`Query: ${args.query}`);\n  return bits.join(' · ').slice(0, 500) || '—';\n}\n\nlet response;\nlet sheetRow = null;\n\nswitch (action) {\n  case 'lookup_knowledge': {\n    const q = String(args.query || '').trim();\n    response = {\n      status: 'ok',\n      action,\n      query: q,\n      results: '',\n      message: 'Use local business_knowledge.md search from voice-agent.',\n    };\n    break;\n  }\n  case 'book_appointment': {\n    response = {\n      status: 'confirmed',\n      action,\n      message: `Appointment noted${args.date ? ' for ' + args.date : ''}${args.time ? ' at ' + args.time : ''}.`.trim(),\n    };\n    sheetRow = {\n      call_id: callId,\n      date,\n      time: timeIst,\n      caller: from,\n      action: 'book_appointment',\n      details: detailsFor(),\n      status: 'confirmed',\n    };\n    break;\n  }\n  case 'create_lead': {\n    response = {\n      status: 'lead_created',\n      action,\n      message: 'Lead captured. The team will follow up shortly.',\n    };\n    sheetRow = {\n      call_id: callId,\n      date,\n      time: timeIst,\n      caller: from,\n      action: 'create_lead',\n      details: detailsFor(),\n      status: 'lead_created',\n    };\n    break;\n  }\n  case 'send_notification': {\n    response = {\n      status: 'notified',\n      action,\n      message: 'Your message has been passed to the team.',\n    };\n    sheetRow = {\n      call_id: callId,\n      date,\n      time: timeIst,\n      caller: from,\n      action: 'send_notification',\n      details: detailsFor(),\n      status: 'notified',\n    };\n    break;\n  }\n  default: {\n    response = { status: 'ok', action, message: `Action '${action}' received.` };\n  }\n}\n\nreturn [{ json: { ...response, sheetRow } }];\n"
      },
