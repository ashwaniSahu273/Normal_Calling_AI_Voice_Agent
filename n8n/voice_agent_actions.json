      "id": "eeeeeeee-eeee-4eee-8eee-eeeeeeeeeeee",
      "name": "Send WhatsApp Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1400, 120]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst body = raw.body || raw;\nconst action = body.action || 'unknown';\nconst args = body.args || {};\n\nlet response;\nswitch (action) {\n  case 'book_appointment': {\n    const parts = [];\n    if (args.date) parts.push(`for ${args.date}`);\n    if (args.time) parts.push(`at ${args.time}`);\n    response = {\n      status: 'confirmed',\n      action,\n      name: args.name || null,\n      date: args.date || null,\n      time: args.time || null,\n      service: args.service || null,\n      message: `Appointment confirmed ${parts.join(' ')}`.trim() + '.',\n    };\n    break;\n  }\n  case 'create_lead': {\n    response = {\n      status: 'lead_created',\n      action,\n      name: args.name || null,\n      phone: args.phone || body.from || null,\n      interest: args.interest || null,\n      message: 'Lead captured. The team will follow up shortly.',\n    };\n    break;\n  }\n  case 'send_notification': {\n    response = {\n      status: 'notified',\n      action,\n      message: 'Your message has been passed to the team.',\n    };\n    break;\n  }\n  default: {\n    response = {\n      status: 'ok',\n      action,\n      message: `Action '${action}' received.`,\n    };\n  }\n}\n\nreturn [{ json: response }];"
      },
