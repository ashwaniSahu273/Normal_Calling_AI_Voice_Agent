      "id": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa",
      "name": "Is Call Ended?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [440, 360]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst body = raw.body || raw;\nconst args = body.args || {};\nconst from = String(body.from || args.caller_phone || args.from || '').replace(/\\D/g, '');\nconst callId = body.call_id || args.call_id || `CALL-${Date.now()}`;\nconst summary = String(args.summary || '').trim() || 'No clear summary was captured. Please review the conversation.';\nconst conversation = String(args.conversation || args.transcript || '').trim();\nconst outcome = args.outcome || args.reason || 'Ended';\nconst intent = args.caller_intent || 'General enquiry';\nconst duration = args.duration || (args.duration_sec ? `${args.duration_sec} sec` : '');\nconst durationSec = args.duration_sec || 0;\nconst date = args.date || new Date().toISOString().slice(0, 10);\nconst timeIst = args.time_ist || '';\nconst business = body.business_name || 'ResilienceSoft';\nconst notify = String(args.notify_whatsapp || body.notify_whatsapp || '').replace(/\\D/g, '');\n\nconst waText = [\n  `📞 *${business} — Call Summary*`,\n  `Date: ${date}${timeIst ? '  ' + timeIst : ''}`,\n  `Caller: ${from || 'unknown'}`,\n  `Duration: ${duration || durationSec + 's'}`,\n  `Outcome: ${outcome}`,\n  `Looking for: ${intent}`,\n  '',\n  `*Summary*`,\n  summary,\n  conversation ? '\\n*Conversation*\\n' + conversation.slice(0, 1800) : ''\n].join('\\n').trim();\n\nconst waBody = notify\n  ? {\n      messageObject: {\n        messaging_product: 'whatsapp',\n        to: notify,\n        type: 'text',\n        text: { body: waText }\n      },\n      enableLog: true\n    }\n  : null;\n\nreturn [{\n  json: {\n    date,\n    time_ist: timeIst,\n    caller_phone: from,\n    duration: duration || String(durationSec),\n    outcome,\n    caller_intent: intent,\n    summary,\n    conversation,\n    business_name: business,\n    call_id: callId,\n    // legacy aliases\n    from_phone: from,\n    ended_at: args.ended_at || new Date().toISOString(),\n    reason: outcome,\n    transcript: conversation,\n    duration_sec: durationSec,\n    notify_whatsapp: notify,\n    waBody,\n    hasWhatsApp: !!waBody,\n    status: 'logged',\n    message: 'Call summarized'\n  }\n}];"
      },
